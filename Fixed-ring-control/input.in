# Auto generated LAMMPS input (no ring)
units           lj
atom_style      full
bond_style      fene # hybrid morse fene
angle_style     cosine
boundary        p p p
read_data       mixture.data
variable        TH equal 1.0

# Neighbor
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Nonbonded
# Default pair coeffs
pair_style      hybrid/overlay zero 1.30 lj/cut 1.1225
pair_coeff      * * lj/cut 1.0 1.0 1.122462048309373
pair_coeff      2 * lj/cut 1.0 2.0 2.244924096618746
pair_coeff      3 4 zero 2.50
pair_modify     mix arithmetic shift yes
special_bonds   lj 0 1 1

# Bonds and angles
bond_coeff      * 30.0 1.5 1.0 1.0
#bond_coeff      1 fene 30.0 1.5 1.0 1.0
#bond_coeff      2 morse 20 5.244 0.97
angle_coeff     1 10.0

# Groups
group           axle      type 1
group           stopper   type 2
group           rx_xlink  type 3
group           bb_end    type 4
group           centers   type 5

# Output
thermo_style     custom step temp pe ke etotal press density lx ly lz
thermo           1000
timestep         0.005
velocity         all create ${TH} 247238746
minimize         1e-8 1e-8 100000 100000
write_data       minimized.data

# Integrator and thermostat
fix             1 all nvt temp ${TH} ${TH} 1 # iso 0.1 0.1 5 drag 2
dump            dcd all dcd 10000 traj.dcd
dump_modify     dcd unwrap yes
dump            dp all custom 100 traj.lammpstrj id type mol xu yu zu
run             10000
unfix           1
undump          dcd
undump          dp
write_data      langevin.data

# Crosslinking with fix/react placeholder
reset_timestep  0
variable        linker atom "type==4"
group           linker dynamic all var linker
variable        nf equal count(linker)
variable        N_initial equal "bonds"
variable        N equal ${N_initial}
variable        Ncl equal "bonds-v_N"
variable        s equal step
variable        F equal 1
variable        B equal 0
variable        den equal "density"
molecule        mol1 pre-molecule.data
molecule        mol2 post-molecule.data
variable        density0 equal "density"
variable        lx0 equal "lx"
variable        ly0 equal "ly"
variable        lz0 equal "lz"
variable        lf equal (((${density0}*${lx0}*${ly0}*${lz0})/0.2)^(1/3))
fix             00 all nve
fix             11 all temp/berendsen ${TH} ${TH} 0.5
fix             22 all deform 1 x final 0 ${lf} y final 0 ${lf} z final 0 ${lf}
dump            11 all custom 1000 shrink.lammpstrj id mol type xu yu zu
run             20000
unfix           00
unfix           11
unfix           22
undump          11
write_data      deformed.data nocoeff 

reset_timestep 0

fix rxns all bond/react stabilization yes statted_grp .03 reset_mol_ids yes &
  react rxn1_stp1 all 100 0.0 1.3 mol1 mol2 automap-F.data prob ${F} 12345 &
  react rxn1_stp1 all 100 0.0 1.3 mol2 mol1 automap-B.data prob ${B} 12345

variable        DoC equal v_Ncl/v_nf
variable        doc equal "v_DoC"
variable        c1 equal f_rxns[1]
variable        c2 equal f_rxns[2]
fix             density all print 100 "${den}" file density.txt  screen no
fix             extra all print 100 "$s ${Ncl} ${c1} ${c2} ${doc}" file excess_bonds.txt screen no
thermo_style    custom step temp etotal ke pe ebond eangle evdwl press vol lx ly lz density f_rxns[1] f_rxns[2] v_DoC
fix             int all nve/limit 0.05
fix             lang all langevin ${TH} ${TH} 2.0 936931 tally no
dump            11 all custom 1000 crosslink-wrap.lammpstrj id mol type xu yu zu
run             100000
unfix           int
unfix           lang
undump          11
write_data      Final.data nocoeff
