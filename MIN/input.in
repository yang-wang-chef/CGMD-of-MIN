# Auto generated LAMMPS input for mixture in LJ units
units           lj
atom_style      full
bond_style      hybrid morse fene
angle_style     cosine
boundary        p p p
read_data       mixture.data
variable        TH equal 1.0

# Neighbor
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

# Nonbonded
pair_style      lj/cut 1.122462048309373
pair_modify     mix arithmetic shift yes
special_bonds   lj 0 1 1

# Default self pair coeffs eps=1 sigma=1 for all types
pair_coeff      * * 1.0 1.0 1.122462048309373

# Stopper bigger sigma
pair_coeff      2 * 1.0 2.0 2.244924096618746

# Strong center-ring recognition for each rotaxane
pair_coeff      5 6 5.000 1.164 2.5
pair_coeff      7 8 5.000 1.164 2.5
