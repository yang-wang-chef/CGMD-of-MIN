# Auto generated LAMMPS input (no ring)
units           lj
atom_style      full
bond_style      hybrid morse fene
angle_style     cosine
boundary        p p p
read_data      mixture-no-ring-8-test.data

# Neighbor
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

# Nonbonded
pair_style      lj/cut 1.122462048309373
pair_modify     mix arithmetic shift yes
special_bonds   lj 0 1 1

# Default pair coeffs
pair_coeff      * * 1.0 1.0 1.122462048309373
pair_coeff      2 * 1.0 2.0 2.244924096618746

# Bonds and angles
bond_coeff      1 fene 30.0 1.5 1.0 1.0
bond_coeff      2 morse 50 3.58 0.96
angle_coeff     1 1.0

# Groups
group           axle      type 1
group           stopper   type 2
group           rx_xlink  type 3
group           bb_end    type 4
group           centers   type 5

# Output
variable        TH equal 1.0
velocity         all create ${TH} 247238746
minimize         1e-8 1e-8 100000 100000

# Integrator and thermostat
thermo_style     custom step temp lx ly lz density press pxx pyy pzz pe ke etotal ebond eangle epair
thermo           1000
timestep         0.01
fix             1 all npt temp ${TH} ${TH} 1 iso 0.1 0.1 5 drag 2
dump            dp all custom 5000 traj.lammpstrj id type mol xu yu zu
run             100000
unfix           1
undump          dp
write_data      npt.data

# Shrink the model to Crosslink with fix/react placeholder
reset_timestep  0
variable        den equal "density"
variable        lx0 equal "lx"
variable        ly0 equal "ly"
variable        lz0 equal "lz"
variable        lf equal (((${den}*${lx0}*${ly0}*${lz0})/0.6)^(1/3))
fix             00 all nve
fix             11 all temp/berendsen ${TH} ${TH} 0.5
fix             22 all deform 1 x final 0 ${lf} y final 0 ${lf} z final 0 ${lf}
dump            11 all custom 1000 shrink.lammpstrj id mol type xu yu zu
run             100000
unfix           00
unfix           11
unfix           22
undump          11
write_data      deformed06.data nocoeff 

# Crosslinking with fix/react placeholder
variable        linker atom "type==4"
group           linker dynamic all var linker
variable        nf equal count(linker)
variable        N_initial equal "bonds"
variable        N equal ${N_initial}
variable        Ncl equal "bonds-v_N"
variable        s equal step
variable        F equal 0.01
variable        B equal 0
molecule        mol1 pre-molecule.data
molecule        mol2 post-molecule.data
reset_timestep  0
fix rxns all bond/react stabilization yes statted_grp .03 reset_mol_ids yes&
  react rxn1_stp1 all 100 0.0 1.1 mol1 mol2 automap-F.data prob ${F} 12345 max_rxn 1044 &
  react rxn1_stp1 all 100 0.0 1.1 mol2 mol1 automap-B.data prob ${B} 12345
comm_modify cutoff 5.0
variable        DoC equal v_Ncl/v_nf
variable        doc equal "v_DoC"
variable        c1 equal f_rxns[1]
variable        c2 equal f_rxns[2]
thermo_style    custom step temp etotal ke pe ebond eangle evdwl press vol lx ly lz density f_rxns[1] f_rxns[2] v_DoC
fix             int all nve/limit 0.05
fix             lang all langevin ${TH} ${TH} 2.0 936931 tally no
dump            11 all custom 1000 crosslink-wrap.lammpstrj id mol type xu yu zu
run             1000000
write_data      Final.data nocoeff
unfix           int
unfix           lang
undump          11
